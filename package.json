{
  "name": "tudela-global-mvp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --configLoader runner && tsc server.ts --outDir dist --module NodeNext --moduleResolution NodeNext --target ES2022 --esModuleInterop --skipLibCheck",
    "build:narration-worker": "tsc server/narrationWorker.ts --outDir dist --module NodeNext --moduleResolution NodeNext --target ES2022 --esModuleInterop --skipLibCheck",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const path of ['dist','server.js']) fs.rmSync(path,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "db:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-local.ps1 build",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-local.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-local.ps1 stop",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-local.ps1 status",
    "db:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-local.ps1 migrate",
    "db:test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-local.ps1 test",
    "auth:bootstrap": "tsx scripts/bootstrap-super-admin.ts",
    "db:seed-content": "tsx scripts/migrate-test-content.ts",
    "test:public-content": "tsx scripts/test-public-content.ts && tsx scripts/test-public-content-data.ts",
    "test:pilot-acceptance": "tsx scripts/test-pilot-acceptance.ts",
    "test:stage4f": "tsx scripts/test-stage4f.ts",
    "test:production-server": "tsx scripts/test-production-server.ts",
    "test:production-monitor": "node scripts/test-production-monitor.mjs",
    "monitor:production": "node scripts/monitor-production.mjs",
    "test:pilot-load": "node scripts/test-pilot-load.mjs",
    "test:discovery-tours": "tsx scripts/test-discovery-tours.ts",
    "test:pilot-catalogue": "tsx scripts/validate-pilot-catalogue.ts",
    "build:pilot-cms-import": "tsx scripts/build-pilot-cms-import.ts",
    "test:licensed-media-import": "tsx scripts/test-licensed-media-import.ts",
    "test:settings": "tsx scripts/test-settings.ts",
    "test:onboarding": "tsx scripts/test-onboarding.ts",
    "test:pwa": "tsx scripts/test-pwa.ts",
    "test:offline-tour": "tsx scripts/test-offline-tour.ts",
    "test:android-pilot": "tsx scripts/test-android-pilot-ux.ts",
    "test:nearby-places": "tsx scripts/test-nearby-places.ts",
    "test:cms-workspace": "tsx scripts/test-cms-workspace.ts",
    "test:interest-filter": "tsx scripts/test-interest-filter.ts",
    "test:ai-foundation": "tsx scripts/test-ai-foundation.ts",
    "test:ai-sources": "tsx scripts/test-ai-sources.ts",
    "test:narration": "tsx scripts/test-narration-foundation.ts",
    "test:narration-worker": "tsx scripts/test-narration-worker.ts",
    "test:audio-upload": "tsx scripts/test-audio-upload.ts",
    "test:narration-playback": "tsx scripts/test-narration-playback.ts",
    "test:narration-coverage": "tsx scripts/test-narration-coverage.ts",
    "test:tour-ratings": "tsx scripts/test-tour-ratings.ts",
    "test:tour-comments": "tsx scripts/test-tour-comments.ts",
    "test:tour-likes-sharing": "tsx scripts/test-tour-likes-sharing.ts",
    "test:heritage-stories": "tsx scripts/test-heritage-stories.ts",
    "test:multilingual-stops": "tsx scripts/test-multilingual-stop-authoring.ts",
    "test:herzl-evals": "tsx scripts/test-herzl-evals.ts",
    "eval:herzl": "tsx scripts/run-herzl-evals.ts",
    "check:production": "tsx scripts/check-production-readiness.ts",
    "backup:storage": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/backup-storage.ps1",
    "verify:storage-backup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-storage-backup.ps1",
    "backup:database": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/backup-database.ps1",
    "verify:database-backup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-database-backup.ps1",
    "drill:recovery": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-recovery-drill.ps1",
    "rotate:database-password": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/rotate-database-password.ps1",
    "verify:database-password": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-database-password.ps1",
    "test:mvp": "tsx scripts/test-mvp.ts",
    "docs:mvp": "node scripts/build-mvp-guide.mjs",
    "build:frontend": "node scripts/build-frontend.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supabase": "2.113.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
