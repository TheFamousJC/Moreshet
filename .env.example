# MVP uses external AI and Google Maps links. No AI or paid Maps API key is needed.
PORT=3220
APP_URL=http://localhost:3220
APP_VERSION=1.0.0-mvp
TRUST_PROXY=false
VITE_GPS_MODE=live
VITE_ORGANIZATION_SLUG=3sci

# Leave blank to use the bundled visitor demonstration.
# Set only after configuring local Supabase or discussing a free hosted project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional in-app Google Maps Embed. Disabled by default.
# Embed usage is no charge but Google requires a billing-enabled project.
# Restrict this browser-visible key to Maps Embed API and permitted website referrers.
VITE_GOOGLE_MAPS_EMBED_KEY=

# For a GitHub Pages frontend with a separate hosted API; use an HTTPS origin.
VITE_API_BASE_URL=

# Comma-separated additional frontend origins allowed to call the API. No wildcards.
MORESHET_ALLOWED_ORIGINS=
